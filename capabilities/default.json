{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, settings, help, search, view and info windows",
  "windows": ["main", "settings", "help", "search", "view", "info"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-unminimize"
  ]
}
